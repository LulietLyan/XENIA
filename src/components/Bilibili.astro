---
import Button from './Button.astro';
const base = import.meta.env.BASE_URL;
const videos = [
  { title: '【Garden Galaxy】这游戏也太上头了！', image: 'garden-galaxy.webp', id: 'BV1YN4y1W7sT', duration: '03:21', tag: 'Garden Galaxy' },
  { title: '《Dinkum》140h+！肝都要没了', image: 'dinkum.webp', id: 'BV13a4y1o7j3', duration: '06:27', tag: 'Dinkum' },
  { title: '成功无伤小旋风最高难度之哈基米焚决', image: 'winds-combat.webp', id: 'BV13y7K6EECp', duration: '03:33', tag: '无伤挑战' },
];
---
<section class="bilibili u-container" id="bilibili" aria-labelledby="bilibili-title">
  <div class="profile">
    <div>
      <p class="eyebrow">OFF THE PAGE / 游戏日常</p>
      <h2 class="u-heading" id="bilibili-title" data-sy-reveal="words">我的 B 站</h2>
      <p class="u-text">bilibili · <a href="https://space.bilibili.com/26270462" target="_blank" rel="noopener noreferrer">@xenia4869 ↗</a></p>
    </div>
    <Button title="去我的 B 站主页" url="https://space.bilibili.com/26270462" target="_blank" arrow />
  </div>
  <div class="videos">
    {videos.map(video => <a class="video" href={`https://www.bilibili.com/video/${video.id}/`} target="_blank" rel="noopener noreferrer" aria-label={`${video.title}（在哔哩哔哩打开）`}>
      <div class="thumbnail"><img src={`${base}social/${video.image}`} alt={video.title} width="672" height="378" loading="lazy" /><span class="play" aria-hidden="true">▷</span><span class="duration">{video.duration}</span></div>
      <div class="video-info"><p>{video.tag}</p><h3>{video.title}</h3><span class="watch">在 bilibili 观看 ↗</span></div>
    </a>)}
  </div>
</section>
<style>
  .bilibili { position: relative; z-index: 2; padding-top: 3rem; padding-bottom: 3rem; }
  .profile { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .eyebrow { font-size: .65rem; letter-spacing: .15em; color: var(--color-brand-1); margin-bottom: 1rem; }
  h2 { --fs: 2.3rem; --lh: 1.3; margin-bottom: 1rem; }
  .profile .u-text { --fs: .8rem; color: var(--color-text-alt); }
  .profile a { color: var(--color-brand-1); }
  .videos { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; }
  .video { border-radius: 1rem; background: var(--color-brand-3); overflow: hidden; }
  .thumbnail { position: relative; aspect-ratio: 16/9; overflow: hidden; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .video:hover img { transform: scale(1.04); }
  .play { position: absolute; left: 1rem; bottom: .7rem; font-size: 1.5rem; color: white; text-shadow: 0 1px 8px #000; }
  .duration { position: absolute; right: .6rem; bottom: .6rem; font-size: .55rem; color: white; background: #111a; padding: .2rem .4rem; border-radius: .25rem; }
  .video-info { padding: 1.1rem; }
  .video-info p { color: var(--color-brand-1); font-size: .6rem; margin: 0 0 .6rem; }
  h3 { font-weight: 500; font-size: .9rem; line-height: 1.7; margin: 0 0 1rem; }
  .watch { font-size: .6rem; }
  @media (max-width: 700px) { .profile { align-items: flex-start; flex-direction: column; } .videos { grid-template-columns: 1fr; } h2 { --fs: 2rem; } }
</style>
